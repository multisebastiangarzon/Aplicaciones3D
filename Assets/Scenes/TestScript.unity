  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cb925e7f8b9e9414eb75437bc209324c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoInteractuable
  lineas:
  - texto: "\xBFQui\xE9n eres? No deber\xEDas estar aqu\xED."
    respuestas:
    - texto: Busco los objetos sagrados
      siguiente: 1
    - texto: Solo estoy de paso
      siguiente: 2
  - texto: "Entonces eres de los que buscan la esmeralda y el disco de oro. Est\xE1n
      repartidos por estas tierras, pero una serpiente patrulla el lugar. Si te ve,
      te devolver\xE1 al \xFAltimo punto de descanso. Esc\xF3ndete tras las rocas."
    respuestas:
    - texto: Gracias por el aviso.
      siguiente: -1
  - texto: "Nadie pasa por aqu\xED por casualidad. Si quieres cruzar, hazlo r\xE1pido:
      la serpiente patrulla y no perdona."
    respuestas:
    - texto: Espera, busco los objetos sagrados.
      siguiente: 1
    - texto: Entendido
      siguiente: -1
  radio: 2.5
  panelDialogo: {fileID: 172188350}
  textoDialogo: {fileID: 1473230155}
  avisoE: {fileID: 2065875700}
  botones:
  - {fileID: 1893555441}
  - {fileID: 157228378}
  - {fileID: 823968268}
